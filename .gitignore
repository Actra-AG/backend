# Ignore everything by default
*

# Allow core files
!/.ddev/
!/.ddev/config.yaml
!/.editorconfig
!/.gitattributes
!/.github/
!/.github/workflows/
!/.github/workflows/assets.yml
!/.github/workflows/release.yml
!/.gitignore
!/.php-cs-fixer.dist.php
!/AGENTS.md
!/CLAUDE.md
!/composer.json
!/package.json
!/package-lock.json
!/postcss.config.js
!/LICENSE
!/phpstan.neon
!/phpunit.xml
!/README.md
!/UPGRADE.md

# Allow the db files
!/db
!/db/**

# Allow the built assets
!/dist
!/dist/**

# Allow the docs
!/docs
!/docs/**

# Allow the src files
!/src
!/src/**

# Allow the tests
!/tests
!/tests/**

# GLOBAL OS FILTERS (Master Rule)
**/.DS_Store
/.DS_Store