includes:
    - vendor/actra/coding-standard/config/phpstan.neon
    # Only for legacy code, may only shrink
    - phpstan-baseline.neon

parameters:
    phpVersion: 80500
    paths:
        - src
        - tests
    scanDirectories:
        # yuf has no Composer autoload configuration (its classes are loaded by actra/autoloader)
        - vendor/actra/yuf/src
